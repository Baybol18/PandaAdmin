<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Panda Cargo</title>
<script>
  (function () {
    var savedTheme = localStorage.getItem('pandaCargo_theme');
    var theme = savedTheme || ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);

    var savedLang = localStorage.getItem('pandaCargo_lang');
    var lang = (savedLang === 'ky' || savedLang === 'ru') ? savedLang : 'ru';
    document.documentElement.setAttribute('lang', lang);
    document.documentElement.setAttribute('data-lang', lang);
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

<div class="app" id="app" hidden>
    
  <!-- ===== ШАПКА ===== -->
  <header class="topbar">
    <div class="topbar__wordmark" aria-label="Panda Cargo">
      <span class="wordmark">
        P<span class="wordmark__panda" aria-hidden="true">
          <svg viewBox="0 0 100 90" class="panda-icon">
            <circle class="panda-ear" cx="16" cy="18" r="15"/>
            <circle class="panda-ear" cx="84" cy="18" r="15"/>
            <ellipse class="panda-face" cx="50" cy="46" rx="46" ry="40"/>
            <ellipse class="panda-patch" cx="27" cy="44" rx="13" ry="16" transform="rotate(-12 27 44)"/>
            <ellipse class="panda-patch" cx="73" cy="44" rx="13" ry="16" transform="rotate(12 73 44)"/>
            <circle class="panda-eye" cx="28" cy="46" r="4.5"/>
            <circle class="panda-eye" cx="72" cy="46" r="4.5"/>
            <ellipse class="panda-nose" cx="50" cy="58" rx="6" ry="4.5"/>
            <ellipse class="panda-cheek" cx="18" cy="64" rx="7" ry="5"/>
            <ellipse class="panda-cheek" cx="82" cy="64" rx="7" ry="5"/>
          </svg>
        </span>nda
      </span>
      <span class="wordmark__sub">CARGO</span>
    </div>

    <div class="topbar__actions">
      <button class="lang-btn" id="langBtn" type="button" aria-label="Language" data-i18n-aria="aria_lang">
        <span class="lang-btn__code" id="langBtnCode">KG</span>
      </button>

      <button class="theme-btn" id="themeBtn" type="button" data-i18n-aria="aria_theme" aria-label="Тема">
        <svg viewBox="0 0 24 24" class="theme-icon theme-icon--sun" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"/>
        </svg>
        <svg viewBox="0 0 24 24" class="theme-icon theme-icon--moon" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>
        </svg>
      </button>

      <button class="notif-btn" id="notifBtn" type="button" data-i18n-aria="aria_notifs" aria-label="Уведомления" data-tab="notifications">
        <svg viewBox="0 0 24 24" class="notif-icon" aria-hidden="true">
          <path d="M12 2a6 6 0 0 0-6 6v3.6c0 .7-.27 1.37-.76 1.87L4 15v2h16v-2l-1.24-1.53a2.7 2.7 0 0 1-.76-1.87V8a6 6 0 0 0-6-6Z"/>
          <path d="M9.5 19a2.5 2.5 0 0 0 5 0"/>
        </svg>
        <span class="notif-badge" id="notifBadge" hidden>0</span>
      </button>

      <button class="logout-btn" id="logoutBtn" type="button" data-i18n-aria="aria_logout" aria-label="Выйти">
        <svg viewBox="0 0 24 24" class="logout-icon" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <path d="M16 17l5-5-5-5"/>
          <path d="M21 12H9"/>
        </svg>
        <span class="logout-btn__text" data-i18n="logout">Выйти</span>
      </button>
    </div>
  </header>

  <main class="main">

    <!-- ===== ВКЛАДКА: ГЛАВНАЯ (QR) ===== -->
    <section class="tab-panel is-active" id="tab-home" data-panel="home" data-i18n-aria="tab_home" aria-label="Главная">
      <div class="ticket" id="clientTicket" data-i18n-aria="ticket_aria" aria-label="Личный QR-код">
        <div class="ticket__main">
          <p class="ticket__eyebrow" data-i18n="your_number">Ваш личный номер</p>
          <p class="ticket__client-id" id="clientId">—</p>

          <dl class="ticket__stats">
            <div class="ticket__stat">
              <dt data-i18n="arrived">Приехало</dt>
              <dd id="statArrived">0</dd>
            </div>
            <div class="ticket__stat">
              <dt data-i18n="received">Получено</dt>
              <dd id="statReceived">0</dd>
            </div>
            <div class="ticket__stat">
              <dt data-i18n="to_pay">К оплате</dt>
              <dd id="statTotal">0 сом</dd>
            </div>
          </dl>
        </div>

        <div class="ticket__tear" aria-hidden="true"></div>

        <div class="ticket__stub">
          <p class="ticket__stub-label" data-i18n="show_qr">Покажите на складе</p>
          <div class="qr-wrap">
            <div id="qrCanvas" class="qr-canvas" role="img" data-i18n-aria="qr_aria" aria-label="QR-код"></div>
            <div class="qr-refresh-ring" id="qrRing" aria-hidden="true"></div>
          </div>
          <p class="pickup-code" id="pickupCode" aria-live="polite">———-———</p>
          <p class="pickup-code-label" data-i18n="pickup_code_label">Код выдачи на сегодня</p>
          <p class="qr-timer">
            <span data-i18n="qr_timer_prefix">Обновится через</span>
            <span id="qrTimer" class="qr-timer__value">24:00:00</span>
          </p>
          <p class="qr-hint" data-i18n="qr_hint">Код обновляется каждый день в 00:00</p>
        </div>
      </div>

      <div class="quick-links">
        <button type="button" class="quick-link" data-tab="shipments">
          <span class="quick-link__icon" aria-hidden="true">📦</span>
          <span class="quick-link__text">
            <strong data-i18n="my_shipments">Мои посылки</strong>
            <small id="quickShipCount">0 шт.</small>
          </span>
          <span class="quick-link__chevron" aria-hidden="true">›</span>
        </button>
        <button type="button" class="quick-link" data-tab="notifications">
          <span class="quick-link__icon" aria-hidden="true">🔔</span>
          <span class="quick-link__text">
            <strong data-i18n="notifications">Уведомления</strong>
            <small id="quickNotifCount">Нет новых</small>
          </span>
          <span class="quick-link__chevron" aria-hidden="true">›</span>
        </button>
        <button type="button" class="quick-link" data-tab="settings">
          <span class="quick-link__icon" aria-hidden="true">⚙️</span>
          <span class="quick-link__text">
            <strong data-i18n="settings">Настройки</strong>
            <small data-i18n="settings_hint">Телефон и пароль</small>
          </span>
          <span class="quick-link__chevron" aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <!-- ===== ВКЛАДКА: ПОСЫЛКИ ===== -->
    <section class="tab-panel" id="tab-shipments" data-panel="shipments" data-i18n-aria="my_shipments" aria-label="Мои посылки" hidden>
      <div class="panel panel--flush">
        <div class="panel__head">
          <h2 class="panel__title" data-i18n="my_shipments">Мои посылки</h2>
        </div>

        <form class="search-form" id="searchForm">
          <input
            type="text"
            id="trackInput"
            class="search-form__input"
            data-i18n-placeholder="track_placeholder"
            placeholder="Трек-код, например CN2026118"
            autocomplete="off"
            inputmode="text"
          >
          <button type="submit" class="search-form__btn" id="searchBtn" data-i18n="find">Найти</button>
        </form>
        <p class="search-form__error" id="searchError" hidden></p>

        <div class="search-result" id="searchResult" hidden>
          <p class="search-result__label" data-i18n="search_result_label">Результат поиска</p>
          <div id="searchResultCard"></div>
        </div>

        <div class="filter-tabs" id="filterTabs" role="tablist">
          <button class="filter-tabs__btn is-active" data-filter="all" type="button" data-i18n="filter_all">Все</button>
          <button class="filter-tabs__btn" data-filter="on_warehouse" type="button" data-i18n="arrived">Приехало</button>
          <button class="filter-tabs__btn" data-filter="delivered" type="button" data-i18n="received_plural">Полученные</button>
        </div>

        <div class="shipment-list" id="shipmentList"></div>
        <p class="shipment-empty" id="shipmentEmpty" data-i18n="empty_shipments" hidden>У вас пока нет посылок</p>
      </div>
    </section>

    <!-- ===== ВКЛАДКА: УВЕДОМЛЕНИЯ ===== -->
    <section class="tab-panel" id="tab-notifications" data-panel="notifications" data-i18n-aria="notifications" aria-label="Уведомления" hidden>
      <div class="panel panel--flush">
        <div class="panel__head">
          <h2 class="panel__title" data-i18n="notifications">Уведомления</h2>
          <button class="panel__action" id="markAllRead" type="button" data-i18n="mark_all_read">Прочитать все</button>
        </div>
        <ul class="notif-list" id="notifList">
          <li class="notif-empty" id="notifEmpty" data-i18n="empty_notifs">Пока нет новых уведомлений</li>
        </ul>
      </div>
    </section>

    <!-- ===== ВКЛАДКА: НАСТРОЙКИ ===== -->
    <section class="tab-panel" id="tab-settings" data-panel="settings" data-i18n-aria="settings" aria-label="Настройки" hidden>
      <div class="panel panel--flush">
        <div class="panel__head">
          <h2 class="panel__title" data-i18n="settings">Настройки</h2>
        </div>

        <div class="settings-block">
          <h3 class="settings-block__title" data-i18n="settings_phone_title">Номер телефона</h3>
          <p class="settings-block__hint" data-i18n="settings_phone_hint">Используется для связи по посылкам</p>
          <form class="settings-form" id="phoneSettingsForm" novalidate>
            <label class="field">
              <span class="field__label" data-i18n="phone">Номер телефона</span>
              <input class="field__input" id="settingsPhone" type="tel" inputmode="tel" autocomplete="tel" required data-i18n-placeholder="phone_placeholder" placeholder="+996 XXX XXX XXX">
            </label>
            <p class="auth-error" id="phoneSettingsError" hidden></p>
            <p class="settings-success" id="phoneSettingsSuccess" hidden></p>
            <button type="submit" class="auth-submit" data-i18n="save_phone">Сохранить номер</button>
          </form>
        </div>

        <div class="settings-block">
          <h3 class="settings-block__title" data-i18n="settings_password_title">Смена пароля</h3>
          <p class="settings-block__hint" data-i18n="settings_password_hint">Введите текущий пароль и новый</p>
          <form class="settings-form" id="passwordSettingsForm" novalidate>
            <label class="field">
              <span class="field__label" data-i18n="current_password">Текущий пароль</span>
              <input class="field__input" id="settingsCurrentPassword" type="password" autocomplete="current-password" minlength="8" required data-i18n-placeholder="password_placeholder" placeholder="8 и более символов">
            </label>
            <label class="field">
              <span class="field__label" data-i18n="new_password">Новый пароль</span>
              <input class="field__input" id="settingsNewPassword" type="password" autocomplete="new-password" minlength="8" required data-i18n-placeholder="password_min_placeholder" placeholder="Минимум 8 символов">
            </label>
            <label class="field">
              <span class="field__label" data-i18n="password_repeat">Повторите пароль</span>
              <input class="field__input" id="settingsNewPassword2" type="password" autocomplete="new-password" minlength="8" required data-i18n-placeholder="password_again_placeholder" placeholder="Ещё раз">
            </label>
            <p class="auth-error" id="passwordSettingsError" hidden></p>
            <p class="settings-success" id="passwordSettingsSuccess" hidden></p>
            <button type="submit" class="auth-submit" data-i18n="save_password">Сменить пароль</button>
          </form>
        </div>
      </div>
    </section>

  </main>

  <!-- ===== НИЖНЯЯ НАВИГАЦИЯ ===== -->
  <nav class="bottom-nav" id="bottomNav" data-i18n-aria="nav_sections" aria-label="Разделы">
    <button type="button" class="bottom-nav__btn is-active" data-tab="home" aria-current="page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5Z"/></svg>
      <span data-i18n="nav_home">Главная</span>
    </button>
    <button type="button" class="bottom-nav__btn" data-tab="shipments">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.5 12 3 3 8.5v7L12 21l9-5.5v-7Z"/><path d="M12 12v9M3 8.5l9 3.5 9-3.5"/></svg>
      <span data-i18n="nav_shipments">Посылки</span>
    </button>
    <button type="button" class="bottom-nav__btn" data-tab="notifications">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a6 6 0 0 0-6 6v3.6c0 .7-.27 1.37-.76 1.87L4 15v2h16v-2l-1.24-1.53a2.7 2.7 0 0 1-.76-1.87V8a6 6 0 0 0-6-6Z"/><path d="M9.5 19a2.5 2.5 0 0 0 5 0"/></svg>
      <span data-i18n="nav_events">События</span>
      <span class="bottom-nav__dot" id="navNotifDot" hidden></span>
    </button>
  </nav>

  <footer class="footer">
    <p class="footer__brand" data-i18n="footer">Panda Cargo</p>
    <p class="footer__help">
      <span data-i18n="footer_help">Возникли вопросы? Напишите нам на</span>
      <!-- Вставьте сюда ссылку на WhatsApp (например: https://wa.me/996XXXXXXXXX) -->
      <a
        class="footer__whatsapp"
        id="whatsappLink"
        href="https://wa.me/message/2K52UAOUU3ZLO1"
        target="_blank"
        rel="noopener noreferrer"
      >WhatsApp</a>
    </p>
  </footer>

</div>

<!-- ===== МОДАЛКА АВТОРИЗАЦИИ ===== -->
<div class="auth-overlay" id="authOverlay" role="dialog" aria-modal="true" aria-labelledby="authTitle">
  <button class="lang-btn lang-btn--auth" id="langBtnAuth" type="button" data-i18n-aria="aria_lang" aria-label="Language">
    <span class="lang-btn__code" id="langBtnAuthCode">KG</span>
  </button>

  <div class="auth-modal">
    <div class="auth-modal__brand">
      <span class="wordmark wordmark--auth">
        P<span class="wordmark__panda" aria-hidden="true">
          <svg viewBox="0 0 100 90" class="panda-icon">
            <circle class="panda-ear" cx="16" cy="18" r="15"/>
            <circle class="panda-ear" cx="84" cy="18" r="15"/>
            <ellipse class="panda-face" cx="50" cy="46" rx="46" ry="40"/>
            <ellipse class="panda-patch" cx="27" cy="44" rx="13" ry="16" transform="rotate(-12 27 44)"/>
            <ellipse class="panda-patch" cx="73" cy="44" rx="13" ry="16" transform="rotate(12 73 44)"/>
            <circle class="panda-eye" cx="28" cy="46" r="4.5"/>
            <circle class="panda-eye" cx="72" cy="46" r="4.5"/>
            <ellipse class="panda-nose" cx="50" cy="58" rx="6" ry="4.5"/>
            <ellipse class="panda-cheek" cx="18" cy="64" rx="7" ry="5"/>
            <ellipse class="panda-cheek" cx="82" cy="64" rx="7" ry="5"/>
          </svg>
        </span>nda
      </span>
      <span class="wordmark__sub">CARGO</span>
    </div>

    <!-- ===== ГЛАВНЫЙ ЭКРАН ===== -->
    <div class="auth-view" id="authHome" data-view="home">
      <h1 class="auth-title" id="authTitle" data-i18n="login_title">Вход</h1>
      <p class="auth-subtitle" data-i18n="login_subtitle">Google или email с кодом из письма</p>

      <button type="button" class="auth-google" id="googleLoginBtn">
        <svg class="auth-google__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span data-i18n="google_btn">Войти через Google</span>
      </button>

      <div class="auth-divider" data-i18n="or_divider">или</div>

      <form class="auth-form" id="emailStartForm" novalidate>
        <label class="field">
          <span class="field__label">Email</span>
          <input class="field__input" id="authEmail" type="email" autocomplete="email" required placeholder="name@example.com">
        </label>
        <p class="auth-error" id="emailStartError" hidden></p>
        <button type="submit" class="auth-submit" data-i18n="send_otp">Отправить код на почту</button>
      </form>
    </div>

    <!-- ===== EMAIL OTP ===== -->
    <div class="auth-view" id="authOtp" data-view="otp" hidden>
      <h1 class="auth-title" data-i18n="verify_title">Проверка email</h1>
      <p class="auth-subtitle" id="otpHint" data-i18n="verify_subtitle">Введите 6-значный код из письма</p>

      <form class="auth-form" id="emailOtpForm" novalidate>
        <label class="field">
          <span class="field__label" data-i18n="otp_label">Код из email</span>
          <input class="field__input field__input--mono field__input--lg" id="emailOtpCode" type="text" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required placeholder="••••••" autocomplete="one-time-code">
        </label>
        <p class="auth-hint" data-i18n="otp_hint">Код действителен несколько минут</p>
        <button type="button" class="auth-resend" id="resendOtpBtn" data-i18n="resend_otp">Отправить код ещё раз</button>
        <p class="auth-error" id="otpError" hidden></p>
        <div class="auth-nav-row">
          <button type="button" class="auth-back" id="otpBackBtn" data-i18n="back">Назад</button>
          <button type="submit" class="auth-submit" data-i18n="next">Далее</button>
        </div>
      </form>
    </div>

    <!-- ===== ПЕРВАЯ РЕГИСТРАЦИЯ: код + пароль ===== -->
    <div class="auth-view" id="authComplete" data-view="complete" hidden>
      <h1 class="auth-title" data-i18n="complete_title">Завершите регистрацию</h1>
      <p class="auth-subtitle" data-i18n="complete_subtitle">Укажите код клиента и придумайте пароль</p>
      <p class="auth-google-user" id="completeUserEmail" hidden></p>

      <form class="auth-form" id="completeForm" novalidate>
        <label class="field">
          <span class="field__label" data-i18n="personal_code">Персональный код</span>
          <input class="field__input field__input--mono field__input--lg" id="completeClientCode" type="text" inputmode="numeric" maxlength="6" required placeholder="126">
        </label>
        <label class="field">
          <span class="field__label" data-i18n="password">Пароль</span>
          <input class="field__input" id="completePassword" type="password" autocomplete="new-password" minlength="8" required data-i18n-placeholder="password_min_placeholder" placeholder="Минимум 8 символов">
        </label>
        <label class="field">
          <span class="field__label" data-i18n="password_repeat">Повторите пароль</span>
          <input class="field__input" id="completePassword2" type="password" autocomplete="new-password" minlength="8" required data-i18n-placeholder="password_again_placeholder" placeholder="Ещё раз">
        </label>
        <div class="pwd-meter" id="completePwdMeter" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <label class="field">
          <span class="field__label" data-i18n="phone">Номер телефона</span>
          <input class="field__input" id="completePhone" type="tel" inputmode="tel" autocomplete="tel" required data-i18n-placeholder="phone_placeholder" placeholder="+996 XXX XXX XXX">
        </label>
        <p class="auth-error" id="completeError" hidden></p>
        <div class="auth-whatsapp-help" id="completeWhatsappHelp" hidden>
          <p class="footer__help">
            <span data-i18n="auth_whatsapp_help">Нужна помощь? Пишите нам на</span>
            <a
              class="footer__whatsapp"
              href="https://wa.me/message/2K52UAOUU3ZLO1"
              target="_blank"
              rel="noopener noreferrer"
            >WhatsApp</a>
          </p>
        </div>
        <button type="submit" class="auth-submit" data-i18n="create_account">Создать аккаунт</button>
      </form>
    </div>

    <!-- ===== ПОВТОРНЫЙ ВХОД ПО EMAIL: код + пароль ===== -->
    <div class="auth-view" id="authConfirm" data-view="confirm" hidden>
      <h1 class="auth-title" data-i18n="confirm_title">Подтверждение</h1>
      <p class="auth-subtitle" data-i18n="confirm_subtitle">Введите персональный код и пароль</p>

      <form class="auth-form" id="confirmForm" novalidate>
        <label class="field">
          <span class="field__label" data-i18n="personal_code">Персональный код</span>
