#style.css
/* =========================================================
   PANDA CARGO — Client Portal
   ========================================================= */

:root {
  --green-deep:    #2F6B24;
  --green-brand:   #4FA336;
  --green-bright:  #78C954;
  --green-pale:    #E6F3DC;

  --ink:           #1A1E16;
  --ink-soft:      #6A7163;

  --paper:         #F7F6F1;
  --paper-dim:     #EEEDE6;
  --white:         #FFFFFF;

  --bamboo:        #C9942E;
  --bamboo-pale:   #F7EDD4;

  --stamp-red:     #C1442D;
  --stamp-red-pale:#F8E2DD;

  --amber-text:    #8A6A16;
  --blue:          #2B5FA0;
  --blue-pale:     #E4EEFA;

  --line:          #E2DED0;

  --panda-black:   #1A1E16;
  --panda-white:   #FFFFFF;

  --shadow-color: 26, 30, 22;

  --font-display: 'Space Grotesk', system-ui, sans-serif;
  --font-body:    'Manrope', system-ui, sans-serif;
  --font-mono:    'JetBrains Mono', 'Courier New', monospace;

  --radius-lg: 22px;
  --radius-md: 14px;
  --radius-sm: 10px;

  --shadow-card: 0 1px 2px rgba(var(--shadow-color), .04), 0 12px 32px -16px rgba(var(--shadow-color), .28);
  --shadow-float: 0 8px 40px -12px rgba(var(--shadow-color), .35);

  --ease-out: cubic-bezier(.22, 1, .36, 1);
  --ease-spring: cubic-bezier(.34, 1.4, .64, 1);

  --nav-h: 68px;
  --safe-b: env(safe-area-inset-bottom, 0px);
}

html[data-theme="dark"] {
  --green-deep:    #5CB044;
  --green-brand:   #6DBB4A;
  --green-bright:  #8AD968;
  --green-pale:    #1C2918;

  --ink:           #EEF0E7;
  --ink-soft:      #A4AA98;

  --paper:         #12140E;
  --paper-dim:     #171910;
  --white:         #1C2016;

  --bamboo:        #E3B453;
  --bamboo-pale:   #2A2314;

  --stamp-red:     #E2745E;
  --stamp-red-pale:#2E1C18;

  --amber-text:    #E3B453;
  --blue:          #7FB2E8;
  --blue-pale:     #182534;

  --line:          #2A2E24;

  --shadow-color: 0, 0, 0;
}

* { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

html,
body {
  transition: background-color .35s var(--ease-out), color .35s var(--ease-out);
}

body {
  margin: 0;
  background: var(--paper-dim);
  background-image:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(79, 163, 54, .12), transparent 55%),
    radial-gradient(circle at 1px 1px, rgba(var(--shadow-color), .045) 1px, transparent 0);
  background-size: auto, 22px 22px;
  color: var(--ink);
  font-family: var(--font-body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  min-height: 100dvh;
}

.app {
  max-width: 480px;
  margin: 0 auto;
  padding: 0 16px calc(var(--nav-h) + var(--safe-b) + 20px);
  min-height: 100dvh;
  animation: fadeUp .55s var(--ease-out) both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: none; }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(18px); }
  to   { opacity: 1; transform: none; }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-18px); }
  to   { opacity: 1; transform: none; }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(.96); }
  to   { opacity: 1; transform: none; }
}

@keyframes softPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(79, 163, 54, .35); }
  50%      { box-shadow: 0 0 0 8px rgba(79, 163, 54, 0); }
}

/* ============ ШАПКА ============ */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 2px 10px;
  position: sticky;
  top: 0;
  z-index: 40;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background: color-mix(in srgb, var(--paper-dim) 82%, transparent);
  margin: 0 -16px;
  padding-left: 16px;
  padding-right: 16px;
}

.topbar__wordmark {
  display: flex;
  align-items: flex-end;
  animation: fadeUp .6s var(--ease-out) .05s both;
}

.wordmark {
  display: inline-flex;
  align-items: flex-end;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 26px;
  letter-spacing: -0.5px;
  color: var(--green-deep);
  line-height: 1;
}

.wordmark__panda {
  display: inline-flex;
  align-items: flex-end;
  margin: 0 1px -2px;
}

.panda-icon { width: 26px; height: 24px; }
.panda-ear    { fill: var(--panda-black); }
.panda-face   { fill: var(--panda-white); stroke: var(--panda-black); stroke-width: 3; }
.panda-patch  { fill: var(--panda-black); }
.panda-eye    { fill: var(--panda-white); }
.panda-nose   { fill: var(--panda-black); }
.panda-cheek  { fill: #F3B6B6; opacity: .8; }

.wordmark__sub {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 3.5px;
  color: var(--green-brand);
  margin-left: 6px;
  padding-bottom: 3px;
}

.topbar__actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.notif-btn,
.theme-btn,
.lang-btn,
.logout-btn {
  position: relative;
  height: 40px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: var(--white);
  display: grid;
  place-items: center;
  cursor: pointer;
  transition:
    background .2s var(--ease-out),
    transform .15s var(--ease-out),
    border-color .2s var(--ease-out),
    box-shadow .25s var(--ease-out);
}

.notif-btn,
.theme-btn,
.lang-btn {
  width: 40px;
}

.lang-btn__code {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .4px;
  color: var(--green-deep);
}

.lang-btn--auth {
  position: absolute;
  top: max(16px, env(safe-area-inset-top));
  right: max(16px, env(safe-area-inset-right));
  z-index: 2;
  box-shadow: var(--shadow-card);
}

.logout-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0 12px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-soft);
}

.logout-btn__text { display: none; }

@media (min-width: 400px) {
  .logout-btn__text { display: inline; }
}

.notif-btn:hover,
.theme-btn:hover,
.lang-btn:hover,
.logout-btn:hover {
  background: var(--green-pale);
  border-color: color-mix(in srgb, var(--green-brand) 40%, var(--line));
}

.notif-btn:active,
.theme-btn:active,
.lang-btn:active,
.logout-btn:active { transform: scale(.94); }

.notif-btn:focus-visible,
.theme-btn:focus-visible,
.lang-btn:focus-visible,
.logout-btn:focus-visible {
  outline: 2px solid var(--green-brand);
  outline-offset: 2px;
}

.notif-icon,
.theme-icon,
.logout-icon {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: var(--ink);
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.theme-icon--moon { fill: var(--ink); stroke: none; }
.logout-icon { stroke: var(--ink-soft); }

html[data-theme="light"] .theme-icon--moon { display: none; }
html[data-theme="dark"]  .theme-icon--sun  { display: none; }

.notif-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: 999px;
  background: var(--stamp-red);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  font-family: var(--font-mono);
  display: grid;
  place-items: center;
  border: 2px solid var(--paper-dim);
  animation: softPulse 2s ease infinite;
}

/* ============ ВКЛАДКИ ============ */

.tab-panel {
  animation: fadeUp .4s var(--ease-out) both;
}

.tab-panel[hidden] { display: none; }

/* ============ КВИТАНЦИЯ / QR ============ */

.ticket {
  position: relative;
  background: var(--white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  margin-top: 6px;
  overflow: hidden;
  border: 1px solid var(--line);
  transition: border-color .3s ease, transform .4s var(--ease-out);
  animation: scaleIn .55s var(--ease-out) .1s both;
}

.ticket__main {
  padding: 22px 20px 18px;
  background:
    linear-gradient(145deg, var(--green-bright) 0%, var(--green-brand) 42%, var(--green-deep) 100%);
  color: #fff;
  position: relative;
}

.ticket__main::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    115deg,
    rgba(255,255,255,.06) 0px,
    rgba(255,255,255,.06) 2px,
    transparent 2px,
    transparent 28px
  );
  pointer-events: none;
}

.ticket__eyebrow {
  margin: 0;
  font-size: 11px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  opacity: .82;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.ticket__client-id {
  margin: 4px 0 16px;
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 700;
  letter-spacing: 1px;
  position: relative;
  z-index: 1;
}

.ticket__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin: 0;
  position: relative;
  z-index: 1;
}

.ticket__stat {
  padding: 8px 10px;
  border-radius: 12px;
  background: rgba(255,255,255,.12);
  backdrop-filter: blur(6px);
}

.ticket__stat dt {
  font-size: 10px;
  opacity: .85;
  margin-bottom: 3px;
  font-weight: 500;
}

.ticket__stat dd {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 15px;
  font-weight: 700;
}

.ticket__tear {
  position: relative;
  height: 0;
  border-top: 2px dashed rgba(var(--shadow-color), .28);
}
.ticket__tear::before,
.ticket__tear::after {
  content: "";
  position: absolute;
  top: -10px;
  width: 20px;
  height: 20px;
  background: var(--paper-dim);
  border-radius: 50%;
}
.ticket__tear::before { left: -10px; }
.ticket__tear::after  { right: -10px; }

.ticket__stub {
  padding: 18px 20px 20px;
  text-align: center;
  background: var(--paper);
}

.ticket__stub-label {
  margin: 0 0 12px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .6px;
  color: var(--ink-soft);
  text-transform: uppercase;
}

.qr-wrap {
  position: relative;
  width: 148px;
  height: 148px;
  margin: 0 auto 12px;
  display: grid;
  place-items: center;
}

.qr-canvas {
  position: relative;
  z-index: 2;
  width: 134px;
  height: 134px;
  background: var(--white);
  border-radius: var(--radius-sm);
  padding: 6px;
  box-shadow: 0 4px 20px -8px rgba(var(--shadow-color), .25);
}

.qr-canvas svg {
  display: block;
  width: 100%;
  height: 100%;
}

.qr-refresh-ring {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  border: 3px solid var(--green-pale);
  border-top-color: var(--green-brand);
  z-index: 1;
  animation: spin 1.2s linear infinite;
  opacity: 0;
  transition: opacity .25s ease;
}
.qr-refresh-ring.is-active { opacity: 1; }

@keyframes spin { to { transform: rotate(360deg); } }

.pickup-code {
  margin: 2px 0 0;
  font-family: var(--font-mono);
  font-size: clamp(28px, 8vw, 36px);
  font-weight: 700;
  letter-spacing: 0.12em;
  line-height: 1.1;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.pickup-code-label {
  margin: 6px 0 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-soft);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.qr-timer {
  margin: 0 0 2px;
  font-size: 12.5px;
  color: var(--ink-soft);
}
.qr-timer__value {
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--ink);
}

.qr-hint {
  margin: 0;
  font-size: 11.5px;
  color: var(--ink-soft);
  opacity: .75;
}

/* ============ БЫСТРЫЕ ССЫЛКИ ============ */

.quick-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
}

.quick-link {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--white);
  box-shadow: var(--shadow-card);
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  color: inherit;
  transition:
    transform .2s var(--ease-out),
    border-color .2s ease,
    box-shadow .25s ease;
  animation: fadeUp .5s var(--ease-out) both;
}
.quick-link:nth-child(1) { animation-delay: .18s; }
.quick-link:nth-child(2) { animation-delay: .26s; }
.quick-link:nth-child(3) { animation-delay: .34s; }

.quick-link:hover {
  border-color: color-mix(in srgb, var(--green-brand) 45%, var(--line));
  box-shadow: var(--shadow-float);
  transform: translateY(-1px);
}
.quick-link:active { transform: scale(.985); }

.quick-link__icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--green-pale);
  display: grid;
  place-items: center;
  font-size: 18px;
  flex-shrink: 0;
}

.quick-link__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.quick-link__text strong {
  font-size: 14.5px;
  font-weight: 700;
  font-family: var(--font-display);
}
.quick-link__text small {
  font-size: 12px;
  color: var(--ink-soft);
}

.quick-link__chevron {
  font-size: 22px;
  color: var(--ink-soft);
  opacity: .5;
  line-height: 1;
}

/* ============ ПАНЕЛИ ============ */

.panel {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 18px 16px 18px;
  margin-top: 6px;
  box-shadow: var(--shadow-card);
  transition: background-color .3s ease, border-color .3s ease;
}

.panel--flush {
  padding-top: 16px;
}

.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.panel__title {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  margin: 0;
  color: var(--ink);
  letter-spacing: -.3px;
}

.panel__action {
  border: none;
  background: none;
  color: var(--green-deep);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  padding: 4px 2px;
  font-family: inherit;
}
.panel__action:hover { text-decoration: underline; }

/* ============ УВЕДОМЛЕНИЯ ============ */

.notif-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: calc(100dvh - 200px);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.notif-item {
  display: flex;
  gap: 12px;
  padding: 12px;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1px solid var(--line);
  position: relative;
  cursor: pointer;
  transition: transform .2s var(--ease-out), background .2s ease;
  animation: fadeUp .35s var(--ease-out) both;
}
.notif-item:active { transform: scale(.985); }

.notif-item.is-unread {
  background: var(--green-pale);
  border-color: color-mix(in srgb, var(--green-brand) 35%, var(--line));
}

.notif-item.is-unread::before {
  content: "";
  position: absolute;
  top: 12px;
  left: -1px;
  width: 3px;
  height: calc(100% - 24px);
  background: var(--green-brand);
  border-radius: 0 3px 3px 0;
}

.notif-item__icon {
  width: 34px;
  height: 34px;
  min-width: 34px;
  border-radius: 10px;
  background: var(--white);
  display: grid;
  place-items: center;
  font-size: 15px;
}

.notif-item__body { flex: 1; min-width: 0; }

.notif-item__title {
  margin: 0 0 2px;
  font-size: 14px;
  font-weight: 650;
  color: var(--ink);
}

.notif-item__text {
  margin: 0;
  font-size: 13px;
  color: var(--ink-soft);
}

.notif-item__time {
  margin: 4px 0 0;
  font-size: 11px;
  color: var(--ink-soft);
  opacity: .75;
  font-family: var(--font-mono);
}

.notif-empty,
.shipment-empty {
  text-align: center;
  color: var(--ink-soft);
  font-size: 14px;
  padding: 28px 0 12px;
  list-style: none;
}

/* ============ ПОИСК ============ */

.search-form {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.search-form__input {
  flex: 1;
  min-width: 0;
  padding: 11px 13px;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--line);
  background: var(--paper);
  font-family: var(--font-mono);
  font-size: 14px;
  color: var(--ink);
  transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
}
.search-form__input:focus-visible {
  outline: none;
  border-color: var(--green-brand);
  background: var(--white);
  box-shadow: 0 0 0 3px var(--green-pale);
}
.search-form__input::placeholder {
  color: #A8A392;
  font-family: var(--font-body);
}

.search-form__btn {
  padding: 0 16px;
  border: none;
  border-radius: var(--radius-md);
  background: linear-gradient(160deg, var(--green-brand), var(--green-deep));
  color: #fff;
  font-weight: 700;
  font-size: 13.5px;
  font-family: inherit;
  cursor: pointer;
  transition: filter .15s ease, transform .1s ease;
}
.search-form__btn:hover { filter: brightness(1.05); }
.search-form__btn:active { transform: scale(.97); }
.search-form__btn:focus-visible {
  outline: 2px solid var(--green-deep);
  outline-offset: 2px;
}

.search-form__error {
  margin: -4px 2px 10px;
  font-size: 13px;
  color: var(--stamp-red);
}

.search-result {
  margin: 0 0 14px;
  padding: 12px;
  border-radius: var(--radius-md);
  border: 1px solid color-mix(in srgb, var(--green-brand) 40%, var(--line));
  background: var(--green-pale);
  animation: fadeUp .35s var(--ease-out) both;
}

.search-result__label {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .4px;
  text-transform: uppercase;
  color: var(--green-deep);
}

.search-result .shipment-card {
  margin: 0;
  background: var(--white);
}

/* ============ ФИЛЬТРЫ ============ */

.filter-tabs {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding-bottom: 12px;
  scrollbar-width: none;
}
.filter-tabs::-webkit-scrollbar { display: none; }

.filter-tabs__btn {
  flex: none;
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 12.5px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: background .2s ease, color .2s ease, border-color .2s ease, transform .15s ease;
}
.filter-tabs__btn:hover { border-color: var(--green-brand); }
.filter-tabs__btn:active { transform: scale(.96); }
.filter-tabs__btn.is-active {
  background: var(--green-brand);
  border-color: var(--green-brand);
  color: #fff;
}

/* ============ КАРТОЧКИ ПОСЫЛОК ============ */

.shipment-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: calc(100dvh - 280px);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 4px;
}

.shipment-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 14px 14px 14px;
  background: var(--paper);
  transition:
    border-color .25s ease,
    box-shadow .3s var(--ease-out),
    background-color .25s ease,
    transform .25s var(--ease-out);
  animation: fadeUp .4s var(--ease-out) both;
}

.shipment-card.is-found {
  border-color: var(--green-brand);
  box-shadow: 0 0 0 3px var(--green-pale);
  transform: scale(1.01);
}

.shipment-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.shipment-card__track {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 14.5px;
  color: var(--ink);
  letter-spacing: .3px;
}

.shipment-card__badge {
  font-size: 10.5px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
  white-space: nowrap;
  text-transform: uppercase;
  letter-spacing: .35px;
}

.shipment-card__badge[data-status="on_warehouse"],
.shipment-card__badge[data-status="arrived"] {
  background: var(--bamboo-pale);
  color: var(--amber-text);
}
.shipment-card__badge[data-status="delivered"],
.shipment-card__badge[data-status="received"] {
  background: var(--green-pale);
  color: var(--green-deep);
}

.shipment-card__meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  padding-top: 12px;
  border-top: 1px dashed var(--line);
}

.shipment-card__meta-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.shipment-card__meta-label {
  font-size: 10px;
  color: var(--ink-soft);
  text-transform: uppercase;
  letter-spacing: .3px;
}

.shipment-card__meta-value {
  font-family: var(--font-mono);
  font-size: 12.5px;
  font-weight: 700;
  color: var(--ink);
}

.shipment-card__storage {
  margin: 10px 0 0;
  padding: 10px 12px;
  border-radius: 12px;
  background: color-mix(in srgb, #c45c26 12%, var(--paper));
  border: 1px solid color-mix(in srgb, #c45c26 28%, var(--line));
  color: #8a3d12;
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.4;
  text-align: left;
}

[data-theme="dark"] .shipment-card__storage {
  background: color-mix(in srgb, #e08a4f 16%, var(--paper));
  border-color: color-mix(in srgb, #e08a4f 35%, var(--line));
  color: #f0c09a;
}

/* ============ НАСТРОЙКИ ============ */

.settings-block {
  padding: 16px 16px 20px;
  border-bottom: 1px solid var(--line);
}

.settings-block:last-child {
  border-bottom: none;
}

.settings-block__title {
  margin: 0 0 4px;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
}

.settings-block__hint {
  margin: 0 0 14px;
  font-size: 13px;
  color: var(--ink-soft);
}

.settings-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.settings-form .auth-submit {
  margin-top: 4px;
}

.settings-success {
  margin: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--green-deep);
}

[data-theme="dark"] .settings-success {
  color: var(--green-pale);
}

/* ============ НИЖНЯЯ НАВИГАЦИЯ ============ */

.bottom-nav {
  position: fixed;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: min(480px, 100%);
  height: calc(var(--nav-h) + var(--safe-b));
  padding: 0 8px var(--safe-b);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: stretch;
  background: color-mix(in srgb, var(--white) 92%, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1px solid var(--line);
  z-index: 50;
  box-shadow: 0 -8px 30px -18px rgba(var(--shadow-color), .35);
}

.bottom-nav__btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  border: none;
  background: none;
  color: var(--ink-soft);
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  padding: 8px 4px;
  transition: color .2s ease, transform .15s var(--ease-out);
}

.bottom-nav__btn svg {
  width: 22px;
  height: 22px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform .25s var(--ease-spring);
}

.bottom-nav__btn.is-active {
  color: var(--green-deep);
}
.bottom-nav__btn.is-active svg {
  transform: translateY(-1px) scale(1.06);
}

.bottom-nav__btn:active { transform: scale(.94); }

.bottom-nav__dot {
  position: absolute;
  top: 10px;
  right: calc(50% - 18px);
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--stamp-red);
  border: 1.5px solid var(--white);
}

/* ============ ФУТЕР ============ */

.footer {
  text-align: center;
  margin-top: 18px;
  color: var(--ink-soft);
  font-size: 12.5px;
  padding-bottom: 4px;
}
.footer__brand {
  margin: 0 0 8px;
  opacity: .7;
  font-weight: 600;
}
.footer__help {
  margin: 0;
  line-height: 1.45;
}
.footer__whatsapp {
  color: #25D366;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 2px;
  margin-left: 4px;
  transition: color .2s ease, opacity .2s ease;
}
.footer__whatsapp:hover {
  color: #1ebe57;
}
.footer__whatsapp:focus-visible {
  outline: 2px solid #25D366;
  outline-offset: 3px;
  border-radius: 2px;
}

/* ============ АВТОРИЗАЦИЯ ============ */

.auth-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 20px 16px calc(20px + var(--safe-b));
  background:
    radial-gradient(ellipse 90% 60% at 50% 0%, rgba(79, 163, 54, .22), transparent 55%),
    var(--paper-dim);
  background-image:
    radial-gradient(ellipse 90% 55% at 50% -5%, rgba(79, 163, 54, .2), transparent 50%),
    radial-gradient(circle at 1px 1px, rgba(var(--shadow-color), .05) 1px, transparent 0);
  background-size: auto, 22px 22px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  animation: fadeIn .35s ease both;
}

.auth-overlay[hidden] { display: none; }

.auth-modal {
  width: min(400px, 100%);
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 28px 22px 22px;
  box-shadow: var(--shadow-float);
  animation: scaleIn .45s var(--ease-out) both;
}

.auth-modal__brand {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-bottom: 22px;
}

.wordmark--auth { font-size: 32px; }
.wordmark--auth .panda-icon { width: 30px; height: 27px; }

.auth-title {
  margin: 0 0 6px;
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -.4px;
  text-align: center;
}

.auth-subtitle {
  margin: 0 0 20px;
  text-align: center;
  color: var(--ink-soft);
  font-size: 14px;
}

.auth-view[hidden] { display: none; }

.auth-steps {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 18px;
}

.auth-steps__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--line);
  transition: background .25s ease, transform .25s var(--ease-spring), width .25s var(--ease-out);
}
.auth-steps__dot.is-active {
  background: var(--green-brand);
  transform: scale(1.15);
  width: 22px;
  border-radius: 999px;
}
.auth-steps__dot.is-done {
  background: var(--green-deep);
}

.auth-steps-track {
  position: relative;
  overflow: hidden;
}

.auth-step {
  animation: slideInRight .35s var(--ease-out) both;
}
.auth-step.is-back {
  animation-name: slideInLeft;
}
.auth-step[hidden] { display: none; }

.method-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  padding: 4px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 14px;
  margin-bottom: 16px;
}

.method-toggle__btn {
  border: none;
  background: transparent;
  padding: 10px;
  border-radius: 11px;
  font-family: inherit;
  font-size: 13.5px;
  font-weight: 650;
  color: var(--ink-soft);
  cursor: pointer;
  transition: background .2s ease, color .2s ease, box-shadow .2s ease;
}
.method-toggle__btn.is-active {
  background: var(--white);
  color: var(--ink);
  box-shadow: 0 2px 8px rgba(var(--shadow-color), .1);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.field[hidden] { display: none; }

.field__label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink-soft);
}

.field__input {
  width: 100%;
  padding: 13px 14px;
  border-radius: 14px;
  border: 1.5px solid var(--line);
  background: var(--paper);
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--ink);
  transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
}
.field__input:focus-visible {
  outline: none;
  border-color: var(--green-brand);
  background: var(--white);
  box-shadow: 0 0 0 3px var(--green-pale);
}
.field__input--mono {
  font-family: var(--font-mono);
  letter-spacing: 1px;
  text-align: center;
}
.field__input--lg {
  font-size: 22px;
  font-weight: 700;
  padding: 16px;
  letter-spacing: 4px;
}

.auth-hint {
  margin: -4px 0 0;
  font-size: 12.5px;
  color: var(--ink-soft);
  text-align: center;
}
.auth-hint strong {
  color: var(--green-deep);
  font-family: var(--font-mono);
}

.auth-resend {
  border: none;
  background: none;
  color: var(--green-deep);
  font-family: inherit;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
  padding: 4px;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.auth-resend:disabled {
  opacity: .55;
  cursor: default;
  text-decoration: none;
}

.auth-error {
  margin: 0;
  font-size: 13px;
  color: var(--stamp-red);
  text-align: center;
}

.auth-google {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1.5px solid var(--line);
  background: var(--white);
  color: var(--ink);
  font-family: inherit;
  font-size: 14px;
  font-weight: 650;
  cursor: pointer;
  transition: border-color .2s ease, background .2s ease, transform .15s ease;
}
.auth-google:hover {
  border-color: color-mix(in srgb, var(--green-brand) 35%, var(--line));
  background: var(--paper);
}
.auth-google:active { transform: scale(.98); }
.auth-google__icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 14px 0;
  color: var(--ink-soft);
  font-size: 12.5px;
  font-weight: 600;
  text-transform: lowercase;
}
.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--line);
}

.auth-google-user {
  margin: -8px 0 16px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--green-deep);
  font-family: var(--font-mono);
}

.auth-whatsapp-help {
  margin-top: 4px;
  padding: 12px;
  border-radius: 12px;
  background: var(--paper);
  border: 1px solid var(--line);
  text-align: center;
  animation: fadeUp .35s var(--ease-out) both;
}
.auth-whatsapp-help .footer__help {
  margin: 0;
  font-size: 13px;
  color: var(--ink-soft);
}
.auth-whatsapp-help .footer__whatsapp {
  margin-left: 4px;
}

.auth-submit {
  margin-top: 4px;
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 14px;
  background: linear-gradient(160deg, var(--green-brand), var(--green-deep));
  color: #fff;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: filter .15s ease, transform .15s var(--ease-out), box-shadow .25s ease;
  box-shadow: 0 8px 24px -10px rgba(47, 107, 36, .55);
}
.auth-submit:hover { filter: brightness(1.05); }
.auth-submit:active { transform: scale(.98); }

.auth-nav-row {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8px;
  margin-top: 4px;
}
.auth-nav-row .auth-submit { margin-top: 0; }

.auth-back {
  padding: 0 16px;
  border-radius: 14px;
  border: 1.5px solid var(--line);
  background: var(--paper);
  color: var(--ink-soft);
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: border-color .2s ease, color .2s ease;
}
.auth-back:hover {
  border-color: var(--green-brand);
  color: var(--ink);
}

.auth-switch {
  display: block;
  width: 100%;
  margin-top: 18px;
  padding: 12px;
  border: none;
  background: none;
  font-family: inherit;
  font-size: 13.5px;
  color: var(--ink-soft);
  cursor: pointer;
  text-align: center;
}
.auth-switch span[data-i18n="register_link"],
.auth-switch span[data-i18n="login_link"] {
  color: var(--green-deep);
  font-weight: 700;
}
.auth-switch:hover span[data-i18n="register_link"],
.auth-switch:hover span[data-i18n="login_link"] {
  text-decoration: underline;
}

.pwd-meter {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-top: -2px;
}
.pwd-meter span {
  height: 4px;
  border-radius: 999px;
  background: var(--line);
  transition: background .25s ease;
}
.pwd-meter[data-level="1"] span:nth-child(1) { background: var(--stamp-red); }
.pwd-meter[data-level="2"] span:nth-child(-n+2) { background: var(--bamboo); }
.pwd-meter[data-level="3"] span { background: var(--green-brand); }

/* ============ АДАПТИВ ============ */

@media (max-width: 380px) {
  .ticket__stats { gap: 6px; }
  .ticket__stat { padding: 7px 6px; }
  .ticket__stat dd { font-size: 13.5px; }
  .ticket__client-id { font-size: 24px; }
  .shipment-card__meta { gap: 4px; }
  .shipment-card__meta-value { font-size: 11.5px; }
  .auth-modal { padding: 24px 16px 18px; border-radius: 24px; }
}

@media (min-width: 640px) {
  .app { padding-top: 4px; }
  .bottom-nav { border-radius: 20px 20px 0 0; }
}

@media (prefers-reduced-motion: reduce) {
  .qr-refresh-ring,
  .notif-badge { animation: none; }
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

