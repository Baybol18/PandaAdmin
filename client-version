  function fillSettingsForm() {
    const phoneInput = document.getElementById('settingsPhone');
    if (phoneInput) phoneInput.value = state.session?.phone || '';
    showError(document.getElementById('phoneSettingsError'), '');
    showError(document.getElementById('passwordSettingsError'), '');
    const phoneOk = document.getElementById('phoneSettingsSuccess');
    const pwdOk = document.getElementById('passwordSettingsSuccess');
    if (phoneOk) phoneOk.hidden = true;
    if (pwdOk) pwdOk.hidden = true;
  }

  function showSuccess(el, message) {
    if (!el) return;
    if (!message) {
      el.hidden = true;
      el.textContent = '';
      return;
    }
    el.hidden = false;
    el.textContent = message;
  }

  function initSettingsUI() {
    document.getElementById('phoneSettingsForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('phoneSettingsError');
      const ok = document.getElementById('phoneSettingsSuccess');
      const btn = e.target.querySelector('.auth-submit');
      showError(err, '');
      showSuccess(ok, '');

      const phone = document.getElementById('settingsPhone').value.trim();
      if (!isValidPhone(phone)) {
        showError(err, t('err_phone'));
        return;
      }

      setBusyButton(btn, true, '…', t('save_phone'));
      try {
        const { data: { user } } = await db.auth.getUser();
        if (!user) throw new Error('No user');
        const normalized = normalizePhone(phone);

        const { error: metaErr } = await db.auth.updateUser({
          data: { phone: normalized }
        });
        if (metaErr) throw metaErr;

        await upsertClientProfile(user, {
          email: user.email || state.session?.email || null,
          clientCode: state.session?.clientCode,
          phone: normalized
        });

        state.session = {
          ...state.session,
          phone: normalized
        };
        showSuccess(ok, t('phone_saved'));
      } catch (error) {
        if (isMissingRelation(error)) showError(err, t('err_clients_table'));
        else showError(err, authErrorMessage(error));
      } finally {
        setBusyButton(btn, false, null, t('save_phone'));
      }
    });

    document.getElementById('passwordSettingsForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('passwordSettingsError');
      const ok = document.getElementById('passwordSettingsSuccess');
      const btn = e.target.querySelector('.auth-submit');
      showError(err, '');
      showSuccess(ok, '');

      const currentPassword = document.getElementById('settingsCurrentPassword').value;
      const newPassword = document.getElementById('settingsNewPassword').value;
      const newPassword2 = document.getElementById('settingsNewPassword2').value;

      if (currentPassword.length < 8) {
        showError(err, t('err_password_len'));
        return;
      }
      if (newPassword.length < 8) {
        showError(err, t('err_password_len'));
        return;
      }
      if (newPassword !== newPassword2) {
        showError(err, t('err_password_match'));
        return;
      }

      setBusyButton(btn, true, '…', t('save_password'));
      try {
        const email = normalizeContact(state.session?.email || '');
        if (!isValidEmail(email)) throw new Error(t('err_email'));

        const { error: checkErr } = await db.auth.signInWithPassword({
          email,
          password: currentPassword
        });
        if (checkErr) {
          showError(err, t('err_current_password'));
          return;
        }

        const { error: updErr } = await db.auth.updateUser({ password: newPassword });
        if (updErr) throw updErr;

        document.getElementById('passwordSettingsForm').reset();
        showSuccess(ok, t('password_saved'));
      } catch (error) {
        showError(err, authErrorMessage(error, 'err_current_password'));
      } finally {
        setBusyButton(btn, false, null, t('save_password'));
      }
    });
  }

