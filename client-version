          <input class="field__input" id="confirmPassword" type="password" autocomplete="current-password" minlength="8" required data-i18n-placeholder="password_placeholder" placeholder="8 и более символов">
        </label>
        <p class="auth-error" id="confirmError" hidden></p>
        <div class="auth-whatsapp-help" id="confirmWhatsappHelp" hidden>
          <p class="footer__help">
            <span data-i18n="auth_whatsapp_help">Нужна помощь? Пишите нам на</span>
            <a
              class="footer__whatsapp"
              href="https://wa.me/message/2K52UAOUU3ZLO1"
              target="_blank"
              rel="noopener noreferrer"
            >WhatsApp</a>
          </p>
        </div>
        <button type="submit" class="auth-submit" data-i18n="login_btn">Войти</button>
      </form>
    </div>
  </div>
</div>

