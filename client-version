  function initLangToggle() {
    document.getElementById('langBtn')?.addEventListener('click', toggleLang);
    document.getElementById('langBtnAuth')?.addEventListener('click', toggleLang);
  }

  /* ============ АВТОРИЗАЦИЯ ============ */

  function showAuth(view) {
    const overlay = document.getElementById('authOverlay');
    const app = document.getElementById('app');
    overlay.hidden = false;
    app.hidden = true;

    const views = {
      home: document.getElementById('authHome'),
      otp: document.getElementById('authOtp'),
      complete: document.getElementById('authComplete'),
      confirm: document.getElementById('authConfirm')
    };

    Object.keys(views).forEach(key => {
      if (views[key]) views[key].hidden = key !== view;
    });
  }

  function hideAuth() {
    document.getElementById('authOverlay').hidden = true;
    document.getElementById('app').hidden = false;
  }

  function updatePwdMeter(password, meterId) {
    const meter = document.getElementById(meterId || 'completePwdMeter');
    if (!meter) return;
    let level = 0;
    if (password.length >= 8) level = 1;
    if (password.length >= 10 && /[0-9]/.test(password)) level = 2;
    if (password.length >= 12 && /[0-9]/.test(password) && /[A-Za-zА-Яа-я]/.test(password)) level = 3;
    meter.dataset.level = String(level);
  }

  function updateVerifyHint() {
    const hint = document.getElementById('otpHint');
    if (!hint) return;
    hint.textContent = state.auth.email
      ? t('code_sent', { contact: state.auth.email })
      : t('verify_subtitle');
  }

  function setWhatsappHelp(id, visible) {
    const el = document.getElementById(id);
    if (el) el.hidden = !visible;
  }

  function resetAuthForms() {
    state.auth = { email: '', flow: null };
    ['authEmail', 'emailOtpCode', 'completeClientCode', 'completePassword', 'completePassword2',
      'completePhone', 'confirmClientCode', 'confirmPassword'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    ['emailStartError', 'otpError', 'completeError', 'confirmError'].forEach(id => {
      showError(document.getElementById(id), '');
    });
    setWhatsappHelp('completeWhatsappHelp', false);
    setWhatsappHelp('confirmWhatsappHelp', false);
    updatePwdMeter('');
  }

  async function finishProfileAndEnter(user, clientCode, password, phone) {
    const code = normalizeClientCode(clientCode);
    const normalizedPhone = normalizePhone(phone);
    const taken = await findClientByCode(code);
    if (taken && taken.id !== user?.id) {
      const err = new Error('CODE_TAKEN');
      err.code = 'CODE_TAKEN';
      throw err;
    }

    const { data: userData, error: userError } = await db.auth.updateUser({
      password,
      data: {
        client_code: code,
        phone: normalizedPhone
      }
    });
    if (userError) throw userError;

    const finalUser = userData?.user || user;
    await upsertClientProfile(finalUser, {
      email: finalUser.email || state.auth.email || null,
      clientCode: code,
      phone: normalizedPhone
    });

    // Гарантируем запись phone в clients (на случай частичного upsert)
    const { error: phoneErr } = await db
      .from('clients')
      .update({ phone: normalizedPhone })
      .eq('id', finalUser.id);
    if (phoneErr && !isMissingRelation(phoneErr)) {
      console.warn('clients phone update:', phoneErr);
      throw phoneErr;
    }

    await linkParcelsToUser(finalUser.id, code);

    const profile = await loadClientProfile(finalUser.id);
    setSession(sessionFromUser(finalUser, profile));
    enterCabinet();
  }

  function showCompleteRegistration(user) {
    showAuth('complete');
    const emailEl = document.getElementById('completeUserEmail');
    if (emailEl) {
      const label = user?.email || state.auth.email || '';
      emailEl.hidden = !label;
      emailEl.textContent = label;
    }
    setWhatsappHelp('completeWhatsappHelp', false);
    showError(document.getElementById('completeError'), '');
  }

  function showConfirmLogin() {
    showAuth('confirm');
    setWhatsappHelp('confirmWhatsappHelp', false);
    showError(document.getElementById('confirmError'), '');
  }

  async function handleAuthenticatedUser(user, options) {
    const opts = options || {};
    const profile = await loadClientProfile(user.id);
    const sessionLike = sessionFromUser(user, profile);

    if (!profileIsComplete(sessionLike)) {
      setSession(sessionLike);
      state.auth.flow = 'register';
      if (user.email) state.auth.email = normalizeContact(user.email);
      showCompleteRegistration(user);
      return;
    }

    // Повторный вход по email: после OTP нужна проверка кода + пароля
    if (opts.requireConfirm) {
      setSession(sessionLike);
      state.auth.flow = 'login';
      if (user.email) state.auth.email = normalizeContact(user.email);
      showConfirmLogin();
      return;
    }

    // Google / уже полная сессия — сразу в кабинет
    setSession(sessionLike);
    enterCabinet();
  }

  function initAuthUI() {
    document.getElementById('completePassword')?.addEventListener('input', (e) => {
      updatePwdMeter(e.target.value, 'completePwdMeter');
      showError(document.getElementById('completeError'), '');
      setWhatsappHelp('completeWhatsappHelp', false);
    });

    document.getElementById('googleLoginBtn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const err = document.getElementById('emailStartError');
      showError(err, '');
      try {
        setBusyButton(btn, true, '…', t('google_btn'));
        await startGoogleAuth();
      } catch (error) {
        showError(err, authErrorMessage(error, 'err_google'));
        setBusyButton(btn, false, null, t('google_btn'));
      }
    });

    document.getElementById('otpBackBtn')?.addEventListener('click', () => {
      showAuth('home');
      showError(document.getElementById('otpError'), '');
    });

    document.getElementById('resendOtpBtn')?.addEventListener('click', async () => {
      const err = document.getElementById('otpError');
      const btn = document.getElementById('resendOtpBtn');
      showError(err, '');
      if (!state.auth.email) return;
      setBusyButton(btn, true, t('sending_otp'), t('resend_otp'));
      try {
        await sendEmailOtp(state.auth.email);
        updateVerifyHint();
      } catch (error) {
        showError(err, authErrorMessage(error, 'err_otp_send'));
      } finally {
        setBusyButton(btn, false, null, t('resend_otp'));
      }
    });

    // Email → OTP
    document.getElementById('emailStartForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('emailStartError');
      const btn = e.target.querySelector('.auth-submit');
      showError(err, '');

      const email = normalizeContact(document.getElementById('authEmail').value);
      if (!isValidEmail(email)) {
        showError(err, t('err_email'));
        return;
      }

      setBusyButton(btn, true, t('sending_otp'), t('send_otp'));
      try {
        state.auth.email = email;
        await sendEmailOtp(email);
        updateVerifyHint();
        showAuth('otp');
      } catch (error) {
        showError(err, authErrorMessage(error, 'err_otp_send'));
      } finally {
        setBusyButton(btn, false, null, t('send_otp'));
      }
    });

    // Verify email OTP
    document.getElementById('emailOtpForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('otpError');
      const btn = e.target.querySelector('.auth-submit');
      showError(err, '');

      const otp = document.getElementById('emailOtpCode').value.trim();
      if (!/^\d{6}$/.test(otp)) {
        showError(err, t('err_otp_format'));
        return;
      }

      setBusyButton(btn, true, t('verifying'), t('next'));
      try {
        const data = await verifyEmailOtp(state.auth.email, otp);
        const user = data?.user;
        if (!user) throw new Error('No user');
        await handleAuthenticatedUser(user, { requireConfirm: true });
      } catch (error) {
        showError(err, authErrorMessage(error, 'err_otp_wrong'));
      } finally {
        setBusyButton(btn, false, null, t('next'));
      }
    });

    // Первая регистрация: код + пароль + телефон
    document.getElementById('completeForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('completeError');
      const btn = e.target.querySelector('.auth-submit');
      showError(err, '');
      setWhatsappHelp('completeWhatsappHelp', false);

      const code = normalizeClientCode(document.getElementById('completeClientCode').value);
      const password = document.getElementById('completePassword').value;
      const password2 = document.getElementById('completePassword2').value;
      const phone = document.getElementById('completePhone').value.trim();

      if (!code || code.length < 2) {
        showError(err, t('err_client_code'));
        return;
      }
      if (password.length < 8) {
        showError(err, t('err_password_len'));
        return;
      }
      if (password !== password2) {
        showError(err, t('err_password_match'));
        return;
      }
      if (!isValidPhone(phone)) {
        showError(err, t('err_phone'));
        return;
      }

      setBusyButton(btn, true, t('creating_account'), t('create_account'));
      try {
        const { data: { user } } = await db.auth.getUser();
        if (!user) throw new Error('No user');
        await finishProfileAndEnter(user, code, password, phone);
      } catch (error) {
        if (error?.code === 'CODE_TAKEN' || String(error?.message || '').includes('CODE_TAKEN')) {
          showError(err, t('err_code_taken'));
          setWhatsappHelp('completeWhatsappHelp', true);
        } else if (error?.code === 'PHONE_REQUIRED') {
          showError(err, t('err_phone'));
        } else if (
          error?.code === '23505' ||
          /duplicate|unique/i.test(String(error?.message || ''))
        ) {
          showError(err, t('err_code_taken'));
          setWhatsappHelp('completeWhatsappHelp', true);
        } else if (isMissingRelation(error)) {
          showError(err, t('err_clients_table'));
        } else {
          showError(err, authErrorMessage(error));
        }
      } finally {
        setBusyButton(btn, false, null, t('create_account'));
      }
    });

    // Повторный вход по email: код + пароль
    document.getElementById('confirmForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('confirmError');
      const btn = e.target.querySelector('.auth-submit');
      showError(err, '');
      setWhatsappHelp('confirmWhatsappHelp', false);

      const code = normalizeClientCode(document.getElementById('confirmClientCode').value);
      const password = document.getElementById('confirmPassword').value;

      if (!code || code.length < 2) {
        showError(err, t('err_client_code'));
        return;
      }
      if (password.length < 8) {
        showError(err, t('err_password_len'));
        return;
      }

      setBusyButton(btn, true, t('logging_in'), t('login_btn'));
      try {
        const { data: { user } } = await db.auth.getUser();
        if (!user) throw new Error('No user');

        const profile = await loadClientProfile(user.id);
        const expected = normalizeClientCode(profile?.client_code || state.session?.clientCode);
        if (!expected || code !== expected) {
          showError(err, t('err_login_code'));
          setWhatsappHelp('confirmWhatsappHelp', true);
          return;
        }

        const email = normalizeContact(user.email || state.auth.email || state.session?.email);
        const { error: pwdError } = await db.auth.signInWithPassword({ email, password });
        if (pwdError) throw pwdError;

        setSession(sessionFromUser(user, profile));
        enterCabinet();
      } catch (error) {
        showError(err, authErrorMessage(error, 'err_login'));
      } finally {
        setBusyButton(btn, false, null, t('login_btn'));
      }
    });

    document.getElementById('logoutBtn')?.addEventListener('click', logout);
  }

  /* ============ КАБИНЕТ ============ */

  async function logout() {
    stopQrRotation();
    try { await db?.auth.signOut(); } catch (_) { /* ignore */ }
    setSession(null);
    state.shipments = [];
    state.notifications = [];
    state.activeFilter = 'all';
    state.activeTab = 'home';
    hideSearchResult();
    resetAuthForms();
    showAuth('home');
  }

  async function enterCabinet() {
    hideAuth();
    switchTab('home');

    if (state.session?.userId) {
      const profile = await loadClientProfile(state.session.userId);
      if (profile) {
        state.session = {
          ...state.session,
          clientCode: normalizeClientCode(profile.client_code) || state.session.clientCode,
          email: profile.email || state.session.email,
          phone: profile.phone || state.session.phone
        };
      }
    }

    const clientId = state.session.clientCode || state.session.userId || 'guest';
    document.getElementById('clientId').textContent = formatClientLabel(state.session.clientCode || '—');
    initQrRotation(clientId, state.session.userId);

    try {
      const shipments = await fetchShipments();
      state.shipments = shipments;
      state.notifications = applyStoredReadState(
        buildNotificationsFromShipments(shipments),
        clientId
      );

      renderStats();
      renderShipments();
      renderNotifications();
    } catch (err) {
      console.error(err);
      state.shipments = [];
      state.notifications = applyStoredReadState(
        [{ id: 'welcome', type: 'info', time: new Date().toISOString(), unread: false }],
        clientId
      );
      renderStats();
      renderShipments();
      renderNotifications();
    }
  }

  /* ============ INIT ============ */

  async function init() {
    applyI18n();
    initThemeToggle();
    initLangToggle();
    initTabs();
    initFilterTabs();
    initSearch();
    initAuthUI();
    initSettingsUI();

    document.getElementById('markAllRead')?.addEventListener('click', markAllNotifsRead);

    try { localStorage.removeItem(SESSION_KEY); } catch (_) { /* ignore */ }

    if (!db) {
      showAuth('home');
      return;
    }

    const { data: { session } } = await db.auth.getSession();
    if (session?.user) {
      // Google OAuth redirect / существующая сессия — без confirm
      await handleAuthenticatedUser(session.user, { requireConfirm: false });
    } else {
      showAuth('home');
    }

    db.auth.onAuthStateChange(async (event, nextSession) => {
      if (event === 'SIGNED_OUT') {
        setSession(null);
        showAuth('home');
        return;
      }
      if (event === 'SIGNED_IN' && nextSession?.user) {
        // Email OTP / формы на overlay сами ведут сценарий; здесь только «тихий» Google redirect
        const overlay = document.getElementById('authOverlay');
        if (overlay && !overlay.hidden) return;

        const completeView = document.getElementById('authComplete');
        const confirmView = document.getElementById('authConfirm');
        const inProfileStep =
          (completeView && !completeView.hidden) ||
          (confirmView && !confirmView.hidden);
        if (!state.session?.clientCode && !inProfileStep) {
          await handleAuthenticatedUser(nextSession.user, { requireConfirm: false });
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', init);

  // API для админки / внешних скриптов (тот же алгоритм суточного кода)
  window.PandaCargo = Object.assign(window.PandaCargo || {}, {
    generateDailyPickupCode,
    localDayKey,
    PICKUP_CODE_SALT
  });
})();

#supabase-clients.sql
-- Panda Cargo: Email + Google Auth, привязка посылок
-- Выполните в Supabase → SQL Editor

create table if not exists public.clients (
  id uuid primary key references auth.users (id) on delete cascade,
  email text,
  phone text,
  client_code text not null,
  created_at timestamptz not null default now(),
  constraint clients_code_unique unique (client_code)
);

alter table public.clients add column if not exists email text;
alter table public.clients add column if not exists phone text;

create unique index if not exists clients_email_unique_idx
  on public.clients (lower(email)) where email is not null;
create index if not exists clients_code_idx on public.clients (client_code);
create index if not exists clients_phone_idx on public.clients (phone);

alter table public.clients enable row level security;

drop policy if exists "clients_select_own" on public.clients;
drop policy if exists "clients_select_check" on public.clients;
drop policy if exists "clients_select_public_check" on public.clients;
drop policy if exists "clients_insert_own" on public.clients;
drop policy if exists "clients_update_own" on public.clients;

create policy "clients_select_own"
  on public.clients for select
  to authenticated
  using (auth.uid() = id);

create policy "clients_select_public_check"
  on public.clients for select
  to anon, authenticated
  using (true);

create policy "clients_insert_own"
  on public.clients for insert
  to authenticated
  with check (auth.uid() = id);

create policy "clients_update_own"
  on public.clients for update
  to authenticated
  using (auth.uid() = id)
  with check (auth.uid() = id);

grant select, insert, update on public.clients to anon, authenticated;

alter table public.parcels
  add column if not exists user_id uuid references auth.users (id) on delete set null;

alter table public.parcels
  add column if not exists client_code text;

alter table public.parcels
  add column if not exists storage_fee numeric not null default 0;

create index if not exists parcels_user_id_idx on public.parcels (user_id);
create index if not exists parcels_client_code_idx on public.parcels (client_code);

alter table public.parcels enable row level security;

drop policy if exists "parcels_select_own" on public.parcels;
drop policy if exists "parcels_select_authenticated" on public.parcels;

create policy "parcels_select_own"
  on public.parcels for select
  to authenticated
  using (
    user_id = auth.uid()
    or client_code = (
      select c.client_code from public.clients c where c.id = auth.uid()
    )
  );

grant select on public.parcels to authenticated;

