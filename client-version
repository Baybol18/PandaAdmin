  /* ============ SUPABASE: ПОСЫЛКИ (привязка к user id) ============ */

  function parcelsSelect() {
    return 'id, track_number, status, weight, price, storage_fee, created_at, user_id, client_code';
  }

  async function fetchShipments() {
    if (!db) return [];
    const userId = state.session?.userId;
    const clientCode = state.session?.clientCode;

    // Сначала пробуем выборку с user_id / client_code / storage_fee
    let query = db
      .from('parcels')
      .select(parcelsSelect())
      .order('created_at', { ascending: false });

    if (userId && clientCode) {
      query = query.or(`user_id.eq.${userId},client_code.eq.${clientCode}`);
    } else if (userId) {
      query = query.eq('user_id', userId);
    } else if (clientCode) {
      query = query.eq('client_code', clientCode);
    }

    let { data, error } = await query;

    // Если колонок ещё нет — fallback без фильтра (пока SQL не выполнен)
    if (error && isMissingRelation(error)) {
      const fallback = await db
        .from('parcels')
        .select('id, track_number, status, weight, price, created_at')
        .order('created_at', { ascending: false });
      data = fallback.data;
      error = fallback.error;
    }

    if (error) {
      console.error('parcels load error:', error);
      throw error;
    }

    return (data || []).map(mapParcel);
  }

  async function searchParcelByTrack(trackNumber) {
    if (!db) throw new Error('Supabase not ready');

    const q = String(trackNumber || '').trim();
    if (!q) return null;

    const userId = state.session?.userId;
    const clientCode = state.session?.clientCode;

    let request = db
      .from('parcels')
      .select(parcelsSelect())
      .ilike('track_number', q)
      .limit(1);

    if (userId && clientCode) {
      request = request.or(`user_id.eq.${userId},client_code.eq.${clientCode}`);
    } else if (userId) {
      request = request.eq('user_id', userId);
    } else if (clientCode) {
      request = request.eq('client_code', clientCode);
    }

    let { data, error } = await request.maybeSingle();

    if (error && isMissingRelation(error)) {
      const fallback = await db
        .from('parcels')
        .select('id, track_number, status, weight, price, created_at')
        .ilike('track_number', q)
        .limit(1)
        .maybeSingle();
      data = fallback.data;
      error = fallback.error;
    }

    if (error) {
      console.error('parcels search error:', error);
      throw error;
    }

    return data ? mapParcel(data) : null;
  }

  function buildNotificationsFromShipments(shipments) {
