  /* ============ ПОСЫЛКИ: РЕНДЕР ============ */

  function renderStats() {
    const arrived = state.shipments.filter(s => s.status === 'on_warehouse').length;
    const received = state.shipments.filter(s => s.status === 'delivered').length;
    const totalDue = state.shipments
      .filter(s => s.status === 'on_warehouse')
      .reduce((sum, s) => sum + (s.totalSom != null ? s.totalSom : s.priceSom + (s.storageFee || 0)), 0);

    const a = document.getElementById('statArrived');
    const r = document.getElementById('statReceived');
    const tot = document.getElementById('statTotal');
    if (a) a.textContent = String(arrived);
    if (r) r.textContent = String(received);
    if (tot) tot.textContent = formatSom(totalDue);
  }

  function buildShipmentCard(shipment) {
    const tpl = document.getElementById('shipmentTemplate');
    const node = tpl.content.firstElementChild.cloneNode(true);

    node.dataset.track = String(shipment.track || '').toUpperCase();
    node.dataset.status = shipment.status;
    node.dataset.filterKey = shipment.status;

    node.querySelector('.shipment-card__track').textContent = shipment.track;

    const badge = node.querySelector('.shipment-card__badge');
    badge.textContent = statusLabel(shipment.status);
    badge.dataset.status = shipment.status;

    node.querySelectorAll('[data-i18n]').forEach(el => {
      el.textContent = t(el.getAttribute('data-i18n'));
    });

    const total = shipment.totalSom != null
      ? shipment.totalSom
      : shipment.priceSom + (shipment.storageFee || 0);

    node.querySelector('.shipment-card__weight').textContent = `${shipment.weightKg} ${t('kg')}`;
    node.querySelector('.shipment-card__price').textContent = formatSom(total);
    node.querySelector('.shipment-card__updated').textContent = formatDateShort(shipment.updatedAt);

    const storageEl = node.querySelector('.shipment-card__storage');
    if (storageEl) {
      if (shipment.status === 'on_warehouse' && shipment.storageFee > 0) {
        storageEl.hidden = false;
        storageEl.textContent = t('storage_warning', { fee: shipment.storageFee });
      } else {
        storageEl.hidden = true;
        storageEl.textContent = '';
      }
    }

    return node;
  }

  function renderShipments() {
    const list = document.getElementById('shipmentList');
    const emptyEl = document.getElementById('shipmentEmpty');
    if (!list) return;

    list.innerHTML = '';

    const visible = state.shipments.filter(s =>
      state.activeFilter === 'all' || s.status === state.activeFilter
    );

    if (visible.length === 0) {
      emptyEl.hidden = false;
      emptyEl.textContent = t('empty_shipments');
      return;
    }
    emptyEl.hidden = true;

    const order = { on_warehouse: 0, delivered: 1 };
    [...visible]
      .sort((a, b) => (order[a.status] ?? 9) - (order[b.status] ?? 9))
      .forEach((s, i) => {
        const card = buildShipmentCard(s);
        card.style.animationDelay = (i * 0.05) + 's';
        list.appendChild(card);
      });
  }

  function showSearchResult(shipment) {
    const wrap = document.getElementById('searchResult');
    const cardHost = document.getElementById('searchResultCard');
    if (!wrap || !cardHost) return;

    cardHost.innerHTML = '';
    const card = buildShipmentCard(shipment);
    card.classList.add('is-found');
    cardHost.appendChild(card);
    wrap.hidden = false;
  }

  function hideSearchResult() {
    const wrap = document.getElementById('searchResult');
    const cardHost = document.getElementById('searchResultCard');
    if (wrap) wrap.hidden = true;
    if (cardHost) cardHost.innerHTML = '';
  }

  function initFilterTabs() {
    const tabs = document.getElementById('filterTabs');
    if (!tabs) return;

    tabs.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-tabs__btn');
      if (!btn) return;

      tabs.querySelectorAll('.filter-tabs__btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      state.activeFilter = btn.dataset.filter;
      renderShipments();
    });
  }

  function initSearch() {
    const form = document.getElementById('searchForm');
    const input = document.getElementById('trackInput');
    const btn = document.getElementById('searchBtn');
    const errorEl = document.getElementById('searchError');
    if (!form || !input) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (state.searching) return;

      showError(errorEl, '');
      hideSearchResult();

      const query = input.value.trim();
      if (!query) return;

      state.searching = true;
      if (btn) {
        btn.disabled = true;
        btn.textContent = t('searching');
      }

      try {
        const match = await searchParcelByTrack(query);

        if (!match) {
          showError(errorEl, t('track_not_found'));
          return;
        }

        // показываем блок результата со status / weight / price
        showSearchResult(match);

        // если посылка уже в общем списке — подсветим её там тоже
        const existing = state.shipments.find(
          s => String(s.track).toUpperCase() === String(match.track).toUpperCase()
        );
        if (!existing) {
          state.shipments = [match, ...state.shipments];
          renderStats();
          updateQuickLinks();
        }

        state.activeFilter = 'all';
        document.querySelectorAll('.filter-tabs__btn').forEach(b =>
          b.classList.toggle('is-active', b.dataset.filter === 'all')
        );
        renderShipments();

        const card = document.querySelector(
          `.shipment-card[data-track="${String(match.track).toUpperCase()}"]`
        );
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.classList.add('is-found');
          setTimeout(() => card.classList.remove('is-found'), 1800);
        }
      } catch (err) {
        console.error(err);
        showError(errorEl, t('search_network_error'));
      } finally {
        state.searching = false;
        if (btn) {
          btn.disabled = false;
          btn.textContent = t('find');
        }
      }
    });

    input.addEventListener('input', () => {
      showError(errorEl, '');
      hideSearchResult();
    });
  }

