  /* ============ УТИЛИТЫ / i18n ============ */

  function t(key, vars) {
    const dict = I18N[state.lang] || I18N.ru;
    let str = dict[key] ?? I18N.ru[key] ?? key;
    if (vars) {
      Object.keys(vars).forEach(k => {
        str = str.replace(new RegExp('\\{' + k + '\\}', 'g'), vars[k]);
      });
    }
    return str;
  }

  function applyI18n() {
    document.documentElement.setAttribute('lang', state.lang);
    document.documentElement.setAttribute('data-lang', state.lang);
    document.title = t('page_title');

    document.querySelectorAll('[data-i18n]').forEach(el => {
      el.textContent = t(el.getAttribute('data-i18n'));
    });

    document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
      el.setAttribute('placeholder', t(el.getAttribute('data-i18n-placeholder')));
    });

    document.querySelectorAll('[data-i18n-aria]').forEach(el => {
      el.setAttribute('aria-label', t(el.getAttribute('data-i18n-aria')));
    });

    const nextCode = state.lang === 'ru' ? 'KG' : 'RU';
    [document.getElementById('langBtnCode'), document.getElementById('langBtnAuthCode')]
      .forEach(el => { if (el) el.textContent = nextCode; });

    updateVerifyHint();

    updateQuickLinks();
    if (state.session) {
      renderStats();
      renderShipments();
      renderNotifications();
    }
  }

  function setLang(lang) {
    state.lang = lang === 'ky' ? 'ky' : 'ru';
    localStorage.setItem(LANG_STORAGE_KEY, state.lang);
    applyI18n();
  }

  function toggleLang() {
    setLang(state.lang === 'ru' ? 'ky' : 'ru');
  }

  function pad2(n) {
    return String(n).padStart(2, '0');
  }

  function formatCountdown(msLeft) {
    const totalSec = Math.max(0, Math.floor(msLeft / 1000));
    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    const s = totalSec % 60;
    return `${pad2(h)}:${pad2(m)}:${pad2(s)}`;
  }

  function formatDateShort(isoString) {
    if (!isoString) return '—';
    const d = new Date(isoString);
    const locale = state.lang === 'ky' ? 'ky-KG' : 'ru-RU';
    return new Intl.DateTimeFormat(locale, {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit'
    }).format(d);
  }

  function formatSom(amount) {
    return new Intl.NumberFormat(state.lang === 'ky' ? 'ky-KG' : 'ru-RU').format(amount) + ' ' + t('som');
  }

  function randomToken(length = 24) {
    const bytes = new Uint8Array(length / 2);
    if (window.crypto && window.crypto.getRandomValues) {
      window.crypto.getRandomValues(bytes);
    } else {
      for (let i = 0; i < bytes.length; i++) bytes[i] = Math.floor(Math.random() * 256);
    }
    return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  function normalizeContact(value) {
    return String(value || '').trim().toLowerCase();
  }

  function normalizeClientCode(value) {
    return String(value || '').trim().replace(/\D/g, '');
  }

  function formatClientLabel(code) {
    const c = normalizeClientCode(code);
    return c ? '№ ' + c.padStart(Math.max(2, c.length), '0') : '—';
  }

  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }

  function normalizePhone(phone) {
    let digits = String(phone || '').replace(/\D/g, '');
    if (!digits) return '';
    if (digits.startsWith('00')) digits = digits.slice(2);
    if (digits.length === 9) digits = '996' + digits;
    if (digits.length === 10 && digits.startsWith('0')) digits = '996' + digits.slice(1);
    return '+' + digits;
  }

  function isValidPhone(v) {
    const digits = String(normalizePhone(v) || '').replace(/\D/g, '');
    return digits.length >= 9 && digits.length <= 15;
  }

  function showError(el, message) {
    if (!el) return;
    if (!message) {
      el.hidden = true;
      el.textContent = '';
      return;
    }
    el.hidden = false;
    el.textContent = message;
  }

  function normalizeStatus(raw) {
    const v = String(raw || '').toLowerCase().trim().replace(/[\s-]+/g, '_');
    if (
      [
        'delivered',
        'received',
        'получено',
        'получен',
        'алынды',
        'issued',
        'done',
        'completed',
        'выдано',
        'picked_up'
      ].includes(v)
    ) {
      return 'delivered';
    }
    // on_warehouse и прочие «на складе»
    return 'on_warehouse';
  }

  function statusLabel(status) {
    return status === 'delivered' ? t('received') : t('arrived');
  }

  function mapParcel(row) {
    const updatedAt = row.created_at || new Date().toISOString();
    const status = normalizeStatus(row.status);
    const priceSom = Number(row.price) || 0;
    // Плата за хранение из БД (parcels.storage_fee)
    const storageFee = Math.max(0, Number(row.storage_fee) || 0);
    return {
      id: row.id,
      track: row.track_number,
      status,
      rawStatus: row.status,
      weightKg: Number(row.weight) || 0,
      priceSom,
      storageFee,
      totalSom: priceSom + storageFee,
      updatedAt
    };
  }

  function notifCopy(n) {
    if (n.type === 'arrived') {
      return {
        title: t('notif_arrived_title'),
        text: t('notif_arrived_text', { track: n.track || '' })
      };
    }
    if (n.type === 'received') {
      return {
        title: t('notif_received_title'),
        text: t('notif_received_text', { track: n.track || '' })
      };
    }
    return {
      title: t('notif_welcome_title'),
      text: t('notif_welcome_text')
    };
  }

  function localDayKey(date) {
    const d = date || new Date();
    return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  }

  function msUntilNextMidnight() {
    const now = new Date();
    const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0, 0);
    return Math.max(0, next.getTime() - now.getTime());
  }

  /* ============ ПОЛЬЗОВАТЕЛИ / СЕССИЯ (Supabase Auth) ============ */

  function setSession(session) {
    state.session = session;
    try { localStorage.removeItem(SESSION_KEY); } catch (_) { /* ignore */ }
    try { localStorage.removeItem('pandaCargo_users'); } catch (_) { /* ignore */ }
  }

  function sessionFromUser(user, profile) {
    if (!user) return null;
    const meta = user.user_metadata || {};
    return {
      userId: user.id,
      email: user.email || profile?.email || meta.email || '',
      phone: profile?.phone || meta.phone || '',
      clientCode: normalizeClientCode(
        profile?.client_code || meta.client_code || meta.clientCode || ''
      )
    };
  }

  function authErrorMessage(error, fallbackKey) {
    const msg = String(error?.message || error?.error_description || '').toLowerCase();
    if (!msg) return t(fallbackKey || 'err_generic');
    if (msg.includes('invalid') && (msg.includes('otp') || msg.includes('token') || msg.includes('credentials'))) {
      return t('err_otp_wrong');
    }
    if (msg.includes('expired')) return t('err_otp_wrong');
    if (msg.includes('already registered') || msg.includes('already been registered') || msg.includes('user already')) {
      return t('err_email_taken');
    }
    if (msg.includes('invalid login') || msg.includes('invalid email or password')) {
      return t('err_login');
    }
    return error.message || t(fallbackKey || 'err_generic');
  }

  function isMissingRelation(error) {
    if (!error) return false;
    if (error.code === '42P01' || error.code === 'PGRST205' || error.code === 'CLIENTS_TABLE_MISSING') return true;
    return /relation .* does not exist|could not find the table|column .* does not exist/i.test(String(error.message || ''));
  }

  async function findClientByCode(clientCode) {
    if (!db) return null;
    const code = normalizeClientCode(clientCode);
    const { data, error } = await db
      .from('clients')
      .select('id, email, phone, client_code')
      .eq('client_code', code)
      .limit(1)
      .maybeSingle();

    if (error) {
      if (isMissingRelation(error)) return null;
      if (error.code === 'PGRST116') return null;
      console.warn('clients code lookup:', error);
      return null;
    }
    return data;
  }

  async function loadClientProfile(userId) {
    if (!db || !userId) return null;
    const { data, error } = await db
      .from('clients')
      .select('id, email, phone, client_code')
      .eq('id', userId)
      .maybeSingle();
    if (error) {
      if (!isMissingRelation(error)) console.warn('clients profile:', error);
      return null;
    }
    return data;
  }

  async function upsertClientProfile(user, profile) {
    if (!db || !user) return;
    const row = {
      id: user.id,
      email: profile.email || user.email || null,
      phone: profile.phone ? normalizePhone(profile.phone) : null,
      client_code: normalizeClientCode(profile.clientCode)
    };
    if (!row.phone) {
      const err = new Error('PHONE_REQUIRED');
      err.code = 'PHONE_REQUIRED';
      throw err;
    }
    const { error } = await db.from('clients').upsert(row, { onConflict: 'id' });
    if (error) {
      if (isMissingRelation(error)) {
        console.warn('clients upsert:', error);
        throw error;
      }
      console.warn('clients upsert:', error);
      throw error;
    }
  }

  async function linkParcelsToUser(userId, clientCode) {
    if (!db || !userId || !clientCode) return;
    const { error } = await db
      .from('parcels')
      .update({ user_id: userId })
      .eq('client_code', normalizeClientCode(clientCode))
      .is('user_id', null);
    if (error && !isMissingRelation(error)) {
      console.warn('parcels link:', error);
    }
  }

  async function sendEmailOtp(email) {
    if (!db) throw new Error('Supabase not ready');
    const normalized = normalizeContact(email);
    const { error } = await db.auth.signInWithOtp({
      email: normalized,
      options: {
        shouldCreateUser: true,
        data: { email: normalized }
      }
    });
    if (error) throw error;
  }

  async function verifyEmailOtp(email, token) {
    if (!db) throw new Error('Supabase not ready');
    const { data, error } = await db.auth.verifyOtp({
      email: normalizeContact(email),
      token,
      type: 'email'
    });
    if (error) throw error;
    return data;
  }

  /** Google OAuth */
  async function startGoogleAuth() {
    if (!db) throw new Error('Supabase not ready');
    const redirectTo = window.location.origin + window.location.pathname;
    const { error } = await db.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo,
        queryParams: {
          prompt: 'select_account'
        }
      }
    });
    if (error) throw error;
  }

  function profileIsComplete(sessionLike) {
    return !!(sessionLike && sessionLike.clientCode && sessionLike.phone);
  }

