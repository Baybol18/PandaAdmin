  /* ============ QR (обновление в 00:00, старый удаляется) ============ */

  /**
   * Суточный код выдачи — общий алгоритм с админкой.
   *
   * Экспорт: window.PandaCargo.generateDailyPickupCode(userId, dateYmd?)
   *
   * Алгоритм (не менять без синхронизации с админкой):
   *   1. date = локальная дата YYYY-MM-DD (по умолчанию сегодня; смена в 00:00)
   *   2. seed = "PandaCargo.pickup.v1|{userId}|{date}"
   *   3. FNV-1a 32-bit по UTF-16 code units строки seed:
   *        hash = 2166136261
   *        for each charCode: hash ^= charCode; hash = (hash * 16777619) mod 2^32
   *   4. n = hash % 1_000_000  → 6 цифр с ведущими нулями
   *   5. формат "XXX-XXX" (например "482-901")
   *
   * Вход userId — auth.users.id (UUID). Дата — локальный календарный день.
   */
  const PICKUP_CODE_SALT = 'PandaCargo.pickup.v1';

  function fnv1a32(str) {
    let hash = 0x811c9dc5;
    for (let i = 0; i < str.length; i++) {
      hash ^= str.charCodeAt(i);
      hash = Math.imul(hash, 0x01000193);
    }
    return hash >>> 0;
  }

  function generateDailyPickupCode(userId, dateYmd) {
    const id = String(userId || '').trim();
    if (!id) return '———-———';
    const day = dateYmd || localDayKey();
    const seed = PICKUP_CODE_SALT + '|' + id + '|' + day;
    const n = fnv1a32(seed) % 1000000;
    const digits = String(n).padStart(6, '0');
    return digits.slice(0, 3) + '-' + digits.slice(3);
  }

  function renderPickupCode(userId) {
    const el = document.getElementById('pickupCode');
    if (!el) return;
    el.textContent = generateDailyPickupCode(userId);
  }

  function qrStorageKey(clientId) {
    return 'pandaCargo_qr_' + clientId;
  }

  function cleanupQrStorage(clientId) {
    const keep = qrStorageKey(clientId);
    const legacy = [
      'pandaCargo_qrIssuedAt_' + clientId,
      'pandaCargo_qrToken_' + clientId
    ];

    legacy.forEach(k => localStorage.removeItem(k));

    Object.keys(localStorage).forEach(key => {
      if (key === keep) return;
      if (
        key.startsWith('pandaCargo_qrIssuedAt_') ||
        key.startsWith('pandaCargo_qrToken_') ||
        (key.startsWith('pandaCargo_qr_') && key !== keep)
      ) {
        // чистим только ключи текущего клиента и устаревшие форматы
        if (key.endsWith('_' + clientId) || key === 'pandaCargo_qr_' + clientId) {
          localStorage.removeItem(key);
        }
      }
    });
  }

  function getOrCreateQrCycle(clientId) {
    cleanupQrStorage(clientId);

    const key = qrStorageKey(clientId);
    const today = localDayKey();
    let stored = null;

    try {
      stored = JSON.parse(localStorage.getItem(key) || 'null');
    } catch {
      stored = null;
    }

    if (stored && stored.day === today && stored.token) {
      return stored;
    }

    // новый день — перезаписываем один ключ (старый токен удаляется)
    const cycle = {
      day: today,
      token: randomToken(),
      issuedAt: Date.now()
    };
    localStorage.setItem(key, JSON.stringify(cycle));
    return cycle;
  }

  function buildQrPayload(clientId, cycle) {
    return JSON.stringify({
      client: clientId,
      day: cycle.day,
      issuedAt: cycle.issuedAt,
      token: cycle.token
    });
  }

  function renderQr(payload) {
    const holder = document.getElementById('qrCanvas');
    if (!holder || typeof qrcode !== 'function') return;

    const qr = qrcode(0, 'M');
    qr.addData(payload);
    qr.make();

    let svg = qr.createSvgTag({ cellSize: 5, margin: 8, scalable: true });
    svg = svg
      .replace('fill="white"', `fill="${QR_COLOR_LIGHT}"`)
      .replace('fill="black"', `fill="${QR_COLOR_DARK}"`);

    holder.innerHTML = svg;
  }

  function pulseRefreshRing() {
    const ring = document.getElementById('qrRing');
    if (!ring) return;
    ring.classList.add('is-active');
    setTimeout(() => ring.classList.remove('is-active'), 900);
  }

  function stopQrRotation() {
    if (qrTimerHandle) {
      clearInterval(qrTimerHandle);
      qrTimerHandle = null;
    }
  }

  function initQrRotation(clientId, userId) {
    stopQrRotation();
    let cycle = getOrCreateQrCycle(clientId);
    renderQr(buildQrPayload(clientId, cycle));
    renderPickupCode(userId);

    const timerEl = document.getElementById('qrTimer');

    function tick() {
      const today = localDayKey();
      if (cycle.day !== today) {
        cycle = getOrCreateQrCycle(clientId);
        renderQr(buildQrPayload(clientId, cycle));
        renderPickupCode(userId);
        pulseRefreshRing();
      }

      if (timerEl) {
        timerEl.textContent = formatCountdown(msUntilNextMidnight());
      }
    }

    tick();
    qrTimerHandle = setInterval(tick, 1000);
  }

  /* ============ УВЕДОМЛЕНИЯ ============ */

  function getReadIds(clientId) {
    try {
      return new Set(JSON.parse(localStorage.getItem('pandaCargo_readNotifs_' + clientId) || '[]'));
    } catch {
      return new Set();
    }
  }

  function saveReadIds(clientId, idsSet) {
    localStorage.setItem(
      'pandaCargo_readNotifs_' + clientId,
      JSON.stringify(Array.from(idsSet))
    );
  }

  function applyStoredReadState(notifications, clientId) {
    const readIds = getReadIds(clientId);
    return notifications.map(n => ({
      ...n,
      unread: n.unread && !readIds.has(n.id)
    }));
  }

  function renderNotifications() {
    const list = document.getElementById('notifList');
    const emptyEl = document.getElementById('notifEmpty');
    if (!list) return;

    Array.from(list.querySelectorAll('.notif-item')).forEach(el => el.remove());

    const sorted = [...state.notifications].sort(
      (a, b) => new Date(b.time) - new Date(a.time)
    );

    if (sorted.length === 0) {
      emptyEl.hidden = false;
      emptyEl.textContent = t('empty_notifs');
    } else {
      emptyEl.hidden = true;
      sorted.forEach((n, i) => {
        const item = buildNotifItem(n);
        item.style.animationDelay = (i * 0.04) + 's';
        list.appendChild(item);
      });
    }

    updateNotifBadge();
    updateQuickLinks();
  }

  function buildNotifItem(n) {
    const copy = notifCopy(n);
    const li = document.createElement('li');
    li.className = 'notif-item' + (n.unread ? ' is-unread' : '');
    li.dataset.id = n.id;
    li.innerHTML = `
      <span class="notif-item__icon">${NOTIF_ICON[n.type] || '📬'}</span>
      <div class="notif-item__body">
        <p class="notif-item__title">${copy.title}</p>
        <p class="notif-item__text">${copy.text}</p>
        <p class="notif-item__time">${formatDateShort(n.time)}</p>
      </div>
    `;
    li.addEventListener('click', () => markNotifRead(n.id));
    return li;
  }

  function markNotifRead(id) {
    if (!state.session) return;
    const n = state.notifications.find(x => x.id === id);
    if (!n || !n.unread) return;
    n.unread = false;

    const readIds = getReadIds(state.session.clientCode);
    readIds.add(id);
    saveReadIds(state.session.clientCode, readIds);
    renderNotifications();
  }

  function markAllNotifsRead() {
    if (!state.session) return;
    const readIds = getReadIds(state.session.clientCode);
    state.notifications.forEach(n => {
      if (n.unread) readIds.add(n.id);
      n.unread = false;
    });
    saveReadIds(state.session.clientCode, readIds);
    renderNotifications();
  }

  function updateNotifBadge() {
    const count = state.notifications.filter(n => n.unread).length;
    const badge = document.getElementById('notifBadge');
    const dot = document.getElementById('navNotifDot');

    if (badge) {
      if (count > 0) {
        badge.hidden = false;
        badge.textContent = count > 9 ? '9+' : String(count);
      } else {
        badge.hidden = true;
      }
    }
    if (dot) dot.hidden = count === 0;
